<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- joint state publisher -->
    <gazebo>
        <plugin filename="ignition-gazebo-joint-state-publisher-system"
                name="ignition::gazebo::systems::JointStatePublisher">
            <joint_name>gimbal_yaw_joint</joint_name>
            <joint_name>gimbal_pitch_joint</joint_name>
            <joint_name>front_left_wheel_joint</joint_name>
            <joint_name>front_right_wheel_joint</joint_name>
            <joint_name>rear_left_wheel_joint</joint_name>
            <joint_name>rear_right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- chassis control (mecanum inverse kinematics) -->
    <gazebo>
        <plugin filename="OmniDrive" name="ignition::gazebo::systems::OmniDrive">
            <chassis_link>chassis</chassis_link>
            <front_left_joint>front_left_wheel_joint</front_left_joint>
            <front_right_joint>front_right_wheel_joint</front_right_joint>
            <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
            <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
            <wheel_radius>0.076</wheel_radius>
            <wheel_separation_x>0.286</wheel_separation_x>
            <wheel_separation_y>0.284</wheel_separation_y>
        </plugin>
    </gazebo>

    <!-- yaw control -->
    <gazebo>
        <plugin filename="ignition-gazebo-joint-controller-system"
                name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_yaw_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>0.5</p_gain>
            <i_gain>0.01</i_gain>
            <d_gain>0.1</d_gain>
            <i_max>1</i_max>
            <i_min>-1</i_min>
            <cmd_max>30</cmd_max>
            <cmd_min>-30</cmd_min>
        </plugin>
    </gazebo>

    <!-- LiDAR sensor (参照 MID360 参数) -->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <frame_name>lidar_link</frame_name>
            <pose>0 0 0.03 3.14159 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1500</samples>
                        <resolution>1.0</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.2831852</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>32</samples>
                        <!-- roll=π 翻转了 Z 轴，垂直角度取反以补偿 -->
                        <min_angle>-0.90757121104</min_angle>
                        <max_angle>0.12217304764</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>40.0</max>
                </range>
            </ray>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </sensor>
    </gazebo>

    <!-- Camera sensor -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>1920</width>
                    <height>1080</height>
                </image>
            </camera>
        </sensor>
    </gazebo>

    <!-- IMU sensor -->
    <gazebo reference="gimbal_pitch">
        <sensor name="gimbal_imu" type="imu">
            <always_on>1</always_on>
            <update_rate>200</update_rate>
        </sensor>
    </gazebo>

    <!-- pitch control -->
    <gazebo>
        <plugin filename="ignition-gazebo-joint-controller-system"
                name="ignition::gazebo::systems::JointController">
            <joint_name>gimbal_pitch_joint</joint_name>
            <use_force_commands>false</use_force_commands>
            <p_gain>0.8</p_gain>
            <i_gain>0.05</i_gain>
            <d_gain>0.2</d_gain>
            <i_max>10</i_max>
            <i_min>-10</i_min>
            <cmd_max>50</cmd_max>
            <cmd_min>-50</cmd_min>
        </plugin>
    </gazebo>

    <!-- ====== directional friction: mu along rolling dir, mu2 along roller dir ====== -->
    <gazebo reference="front_left_wheel">
        <mu1>1.0</mu1>
        <mu2>0.01</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="front_right_wheel">
        <mu1>1.0</mu1>
        <mu2>0.01</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="rear_left_wheel">
        <mu1>1.0</mu1>
        <mu2>0.01</mu2>
        <fdir1>-1 0 0</fdir1>
    </gazebo>
    <gazebo reference="rear_right_wheel">
        <mu1>1.0</mu1>
        <mu2>0.01</mu2>
        <fdir1>-1 0 0</fdir1>
    </gazebo>
</robot>
