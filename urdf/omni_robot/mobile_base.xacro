<?xml version="1.0"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <!-- ========== 底盘尺寸 ========== -->
    <xacro:property name="base_length" value="0.5"/>
    <xacro:property name="base_width" value="0.5"/>
    <xacro:property name="base_height" value="0.2"/>

    <!-- ========== 全向轮尺寸 ========== -->
    <xacro:property name="wheel_radius" value="0.06"/>
    <xacro:property name="wheel_length" value="0.04"/>
    <xacro:property name="wheel_mass" value="0.5"/>

    <!-- 轮子到底盘底部的间隙 (m) -->
    <xacro:property name="wheel_chassis_gap" value="0.03"/>

    <!-- ========== 轮子宏 ========== -->
    <!-- 全向轮：圆柱体，旋转轴在 link 本地坐标系中沿 y 轴 -->
    <!-- 滚子垂直于主轮（沿 y 轴方向自由滑动） -->
    <!-- 关节 rpy 控制轮子在底盘坐标系中的朝向（X 型 45° 布局） -->
    <xacro:macro name="wheel_link" params="prefix color">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
                <material name="${color}"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_length}"
                                    o_xyz="0 0 0" o_rpy="${pi/2.0} 0 0"/>
        </link>
    </xacro:macro>

    <!-- ========== 基座标系 ========== -->
    <link name="base_footprint"/>

    <!-- ========== 底盘 link ========== -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
        <xacro:box_inertia m="8.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <!-- ========== 四个全向轮 link ========== -->
    <xacro:wheel_link prefix="fl" color="grey"/>
    <xacro:wheel_link prefix="fr" color="grey"/>
    <xacro:wheel_link prefix="rl" color="grey"/>
    <xacro:wheel_link prefix="rr" color="grey"/>

    <!-- ========== 轮子关节（X 型全向轮布局） ========== -->
    <!--
      X 型布局（俯视图，x 前 y 左）:

               RL (↖)          FL (↗)
                 \   45°    45°  /
                  \            /
                   \  底盘中心 /
                   /          \
                  /  45°    45°  \
                 /               \
               RR (↙)          FR (↘)

      每个轮子的旋转轴沿对角线向外。箭头方向 = 轴的正方向。
      在轮子本地坐标系中，旋转轴沿 y 轴 (axis="0 1 0")，
      通过关节 rpy 的 Z 轴旋转将轴转到对应方向。

      轮子 xy 位置：内收半个轮宽，不超出底盘轮廓。
          z 位置：向下到地面（轮子中心 z = wheel_radius，刚好触地）
    -->
    <xacro:property name="wheel_x" value="${base_length/2.0 - wheel_length/2.0}"/>
    <xacro:property name="wheel_y" value="${base_width/2.0 - wheel_length/2.0}"/>
    <xacro:property name="wheel_z" value="${-(base_height/2.0 + wheel_radius + wheel_chassis_gap)}"/>

    <!-- FL (front-left, 左上)：轴朝向右前 → 指向 (0.707, 0.707, 0) -->
    <joint name="base_fl_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="fl_wheel_link"/>
        <origin xyz="${wheel_x} ${wheel_y} ${wheel_z}" rpy="0 0 ${-pi/4}"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- FR (front-right, 右上)：轴朝向右侧 → 指向 (0.707, -0.707, 0) -->
    <joint name="base_fr_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="fr_wheel_link"/>
        <origin xyz="${wheel_x} ${-wheel_y} ${wheel_z}" rpy="0 0 ${-3*pi/4}"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- RL (rear-left, 左下)：轴指向左后 → 指向 (-0.707, 0.707, 0) -->
    <joint name="base_rl_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rl_wheel_link"/>
        <origin xyz="${-wheel_x} ${wheel_y} ${wheel_z}" rpy="0 0 ${pi/4}"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- RR (rear-right, 右下)：轴指向左 → 指向 (-0.707, -0.707, 0) -->
    <joint name="base_rr_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="rr_wheel_link"/>
        <origin xyz="${-wheel_x} ${-wheel_y} ${wheel_z}" rpy="0 0 ${3*pi/4}"/>
        <axis xyz="0 1 0"/>
    </joint>

    <!-- ========== base_footprint → base_link（抬高底盘，轮子刚好触地） ========== -->
    <xacro:property name="base_lift" value="${base_height/2.0 + 2.0*wheel_radius + wheel_chassis_gap}"/>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${base_lift}" rpy="0 0 0"/>
    </joint>

</robot>
